<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/editProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome do Produto" />

    <EditText
        android:id="@+id/editProductPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Preço" />

    <EditText
        android:id="@+id/editProductDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descrição" />

    <EditText
        android:id="@+id/editProductQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="Quantidade" />

    <Button
        android:id="@+id/btnInserirProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inserir Produto" />

    <Button
        android:id="@+id/btnListarProdutos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listar Produtos" />

    <EditText
        android:id="@+id/editSearchName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar por nome"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnBuscarProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buscar Produto" />

    <Button
        android:id="@+id/btnExcluirTodos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Excluir Todos" />

    <EditText
        android:id="@+id/editUpdateId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="ID para Atualizar"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/editUpdatePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Novo Preço" />

    <Button
        android:id="@+id/btnAtualizarProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atualizar Preço" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/textProductList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp" />
    </ScrollView>

</LinearLayout>
